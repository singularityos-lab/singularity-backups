<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Singularity</vendor>
  <action id="dev.sinty.backups.restore-system">
    <description>Restore the system configuration from a backup</description>
    <message>Authentication is required to restore the system configuration from a backup</message>
    <icon_name>dev.sinty.backups</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXECDIR@/singularity-backups-system-helper</annotate>
  </action>
</policyconfig>
